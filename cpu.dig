    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>cpu</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>clk ReadData1 ReadData2
0 0 0        # addi x4, x0, -20
C (-20) 0    # addi x5, x4, 0x7F0      ; x4 = -20
C 2012 0     # addi x6, x5, 0x701      ; x5 = 2012
C 3805 0     # addi x7, x6, 0x531      ; x6 = 3805
C 3805 0     # andi x14, x6, 0x123     ; rs1 = x6
C 1 0        # andi x15, x14, 0x71C    ; rs1 = x14 = 1
C 0 0        # andi x17, x15, 0x541    ; rs1 = x15 = 0
C (-20) 0    # slti x18, x4, 311       ; rs1 = x4
C 1 0        # slti x19, x18, 2        ; rs1 = x18 = 1
C 1 0        # slti x20, x19, 0        ; rs1 = x19 = 1
C 0 0        # slti x21, x20, -3       ; rs1 = x20 = 0
C 0 2012        # slti x22, x21, 5        ; rs1 = x21 = 0
C 1 0        # addi x0,  x22, 0        ; rs1 = x22 = 1 (write to x0 ignored)
C (-20) 0    # slti x23, x4,  -20      ; rs1 = x4
C 0 0        # addi x0,  x23, 0        ; rs1 = x23 = 0
C 0 3805        # slti x24, x11, -90      ; x11 was never set, so 0
C 0 0        # addi x0,  x24, 0        ; rs1 = x24 = 0
C (-20) 0    # slti x25, x4,  0        ; rs1 = x4
C 1 0        # addi x0,  x25, 0        ; rs1 = x25 = 1
C 0 0        # slti x26, x11, 600      ; x11 still 0
C 1 0        # addi x0,  x26, 0        ; rs1 = x26 = 1
C (-20) 0    # slti x27, x4,  -1       ; rs1 = x4
C 1 0        # addi x0,  x27, 0        ; rs1 = x27 = 1
C 0 (-20)    # addi x8,  x0, 100
C 0 0    # addi x9,  x0, -1
C 100 (-1)    # add  x10, x8, x9
C 99 (-20)    # add  x11, x10, x4
C (-1) (-1)    # add  x12, x9, x9
C 100 100    # add  x0,  x8, x8
C 0 (-2)    # add  x13, x0, x12
C 100 (-1)    # sub  x16, x8, x9
C (-1) 100    # sub  x28, x9, x8
C 101 101    # sub  x29, x16, x16
C 0 (-101)    # sub  x30, x29, x28
C 2012 3805    # or   x31, x5, x6
C 4061 0    # or   x1,  x31, x0
C 100 (-1)    # or   x2,  x8, x9
C 2012 3805    # and  x3,  x5, x6
C 1756 (-1)    # and  x10, x3, x9
C 1756 0    # and  x11, x10, x0
C 0 0    # addi x12, x0, -2048
C (-2048) 4061    # addi x13, x12, 2047
C (-1) 0    # andi x16, x13, -2048
C 3805 4061    # andi x28, x6, -1
C (-20) (-1)    # slti x29, x4, -19
C 100 4061    # slti x30, x8, -1
C (-1) 4061    # slti x31, x9, 1
C 1 0    # addi x0,  x29, 0
C 0 0    # addi x0,  x30, 0
C 1 0    # addi x0,  x31, 0
C (-20) 100    # slt  x1,  x4, x8
C 100 (-20)    # slt  x2,  x8, x4
C (-1) 0    # slt  x3,  x9, x0
C 0 (-1)    # slt  x10, x0, x9
C 100 100    # slt  x11, x8, x8
C 1 0    # add  x0,  x1, x2
C 1 0    # add  x0,  x3, x10
C 0 0    # addi x0,  x11, 0
C 0 1    # addi x1,  x0, 31
C 0 31    # addi x2,  x0, 1
C 0 0    # addi x3,  x0, 32
C 1 31    # sll  x10, x2, x1
C (-1) 0    # sll  x11, x9, x0
C 1 32    # sll  x12, x2, x3
C 100 1    # sll  x13, x8, x2
C (-2147483648) (-1)    # add  x16, x10, x9
C 2147483647 1    # add  x28, x16, x2
C (-2147483648) 2147483647    # slt  x29, x10, x16
C 2147483647 (-2147483648)    # slt  x30, x16, x10
C (-1) 1    # add  x0,  x11, x12
C 200 (-2147483648)    # add  x0,  x13, x28
C 1 0    # add  x0,  x29, x30
C (-2147483648) 31    # srl  x11, x10, x1
C (-20) 1    # srl  x12, x4, x2
C (-20) 32    # srl  x13, x4, x3
C (-20) 0    # srl  x16, x4, x0
C 1 2147483638    # add  x0,  x11, x12
C (-20) (-20)    # add  x0,  x13, x16
C (-2147483648) 31    # sra  x11, x10, x1
C (-20) 1    # sra  x12, x4, x2
C (-20) 32    # sra  x13, x4, x3
C (-20) 0    # sra  x16, x4, x0
C 100 1    # sra  x28, x8, x2
C (-1) (-10)    # add  x0,  x11, x12
C (-20) (-20)    # add  x0,  x13, x16
C 50 0    # addi x0,  x28, 0
</dataString>
          </testData>
        </entry>
