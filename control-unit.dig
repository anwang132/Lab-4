# all eleven supported patterns
0b0110011 0b000 0b0000000 1 0 0b00 0b0010
0b0110011 0b000 0b0100000 1 0 0b00 0b0110
0b0110011 0b111 0b0000000 1 0 0b00 0b0000
0b0110011 0b110 0b0000000 1 0 0b00 0b0001
0b0110011 0b010 0b0000000 1 0 0b00 0b0111
0b0010011 0b000 0b0000000 1 1 0b00 0b0010
0b0010011 0b010 0b0000000 1 1 0b00 0b0111
0b0010011 0b111 0b0000000 1 1 0b00 0b0000
0b0110011 0b001 0b0000000 1 0 0b00 0b0100
0b0110011 0b101 0b0000000 1 0 0b00 0b0101
0b0110011 0b101 0b0100000 1 0 0b00 0b1000
# I-type with varied upper immediate bits (funct7 field), including negative immediates
0b0010011 0b000 0b1111111 1 1 0b00 0b0010
0b0010011 0b000 0b0100000 1 1 0b00 0b0010
0b0010011 0b010 0b1111110 1 1 0b00 0b0111
0b0010011 0b010 0b0011001 1 1 0b00 0b0111
0b0010011 0b111 0b1000000 1 1 0b00 0b0000
0b0010011 0b111 0b0101010 1 1 0b00 0b0000
# unsupported opcodes must not write
0b0000000 0b000 0b0000000 0 X X X
0b0000011 0b010 0b0000000 0 X X X
0b0100011 0b010 0b0000000 0 X X X
0b1100011 0b000 0b0000000 0 X X X
0b0110111 0b000 0b0000000 0 X X X
0b1101111 0b000 0b0000000 0 X X X
# unsupported R-type combinations must not write
0b0110011 0b011 0b0000000 0 X X X
0b0110011 0b100 0b0000000 0 X X X
0b0110011 0b111 0b0100000 0 X X X
0b0110011 0b001 0b0100000 0 X X X
0b0110011 0b000 0b0000001 0 X X X
0b0110011 0b101 0b1100000 0 X X X
# unsupported I-type funct3 (sltiu, xori, ori, slli, srli/srai) must not write
0b0010011 0b011 0b0000000 0 X X X
0b0010011 0b100 0b0000000 0 X X X
0b0010011 0b110 0b0000000 0 X X X
